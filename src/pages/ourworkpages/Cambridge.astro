---
import { client, urlFor } from "@/lib/sanityClient";
import MainLayout from "../../lib/layouts/main-layout.astro";
import type { ProjectType } from "@/types/project.types";

export const prerender = false;

const query = `*[_type == "project" && name == "Jane's House"][0]`;
const project: ProjectType = await client.fetch(query);

const images = await Promise.all(
  project?.images?.map((image) => urlFor(image).url())
);
---

<MainLayout activePath="/our-work">
  <!-- project -->
  <div class="mry-about mry-p-100-100">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="mry-mb-100 mry-text-center">
            <div class="mry-numbering mry-fo">
              <div class="mry-border-text">01</div>
              <div class="mry-subtitle">Goal</div>
            </div>
            <h3 class="mry-mb-40 mry-fo">
              Jane's House<br />
              <span class="mry-border-text"
                >Modern Living with a Timeless Touch
              </span>
            </h3>
            <p class="mry-text mry-fo">
              This contemporary minimalist home embraces simplicity with a
              luxurious edge. Thoughtful design, clean lines, and high-end
              finishes come together in a space that feels open, elegant, and
              effortlessly livable.
            </p>
          </div>
        </div>
        <div class="col-lg-12">
          <div class="mry-main-title mry-title-center mry-p-0-40">
            <div class="mry-numbering mry-fo">
              <div class="mry-border-text">02</div>
              <div class="mry-subtitle">Project</div>
            </div>
            <h2 class="mry-fo">Project gallery</h2>
          </div>
        </div>
        <div class="col-lg-12">
          <div class="mry-portfolio-frame">
            <div class="mry-masonry-grid mry-without-descr mry-p-0-100">
              <div class="mry-grid-sizer"></div>

              {
                images.map((image) => (
                  <div class="mry-masonry-grid-item mry-masonry-grid-item-50 interior">
                    <div class="mry-card-item">
                      <div class="mry-card-cover-frame mry-mb-20 mry-fo">
                        <img src={image} alt="project" />
                        <div class="mry-cover-overlay" />
                        <div class="mry-hover-links">
                          <a
                            href={image}
                            data-fancybox="works"
                            class="mry-zoom mry-magnetic-link"
                          >
                            <span class="mry-magnetic-object">
                              <i class="fas fa-expand" />
                            </span>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="container" style="padding-bottom: 70px;">
          <div class="row">
            <div class="col-lg-12">
              <div class="mry-main-title mry-title-center mry-p-0-40">
                <div class="mry-subtitle mry-mb-20 mry-fo">More projects</div>
                <h2 class="mry-fo">Similar projects</h2>
              </div>
            </div>
          </div>

          <div class="row justify-content-center">
            <div class="col-lg-5">
              <div class="mry-card-item">
                <div class="mry-card-cover-frame mry-mb-20 mry-fo">
                  <!-- <div class="mry-badge">Bathroom</div> -->
                  <img
                    src="https://res.cloudinary.com/daoju0r3c/image/upload/v1755028290/jain_cover_zlufdd.jpg"
                    alt="project"
                  />
                  <div class="mry-cover-overlay"></div>
                  <div class="mry-hover-links">
                    <a
                      href="https://res.cloudinary.com/daoju0r3c/image/upload/v1755028290/jain_cover_zlufdd.jpg"
                      data-fancybox="works-slider"
                      class="mry-zoom mry-magnetic-link"
                      ><span class="mry-magnetic-object"
                        ><i class="fas fa-expand"></i></span
                      ></a
                    >
                    <a
                      href="/ourworkpages/hiltontower/"
                      class="mry-more mry-magnetic-link mry-anima-link"
                      ><span class="mry-magnetic-object"
                        ><i class="fas fa-arrow-right"></i></span
                      ></a
                    >
                  </div>
                </div>
                <div class="mry-item-descr mry-fo">
                  <h4 class="mry-mb-10">
                    <a href="/ourworkpages/hiltontower/">Jain House</a>
                  </h4>
                </div>
              </div>
            </div>

            <div class="col-lg-5">
              <div class="mry-card-item">
                <div class="mry-card-cover-frame mry-mb-20 mry-fo">
                  <!-- <div class="mry-badge">Bedroom</div> -->
                  <img
                    src="https://res.cloudinary.com/daoju0r3c/image/upload/v1757358799/Kphouse_tpr9f8.jpg"
                    alt="project"
                  />
                  <div class="mry-cover-overlay"></div>
                  <div class="mry-hover-links">
                    <a
                      href="https://res.cloudinary.com/daoju0r3c/image/upload/v1757358799/Kphouse_tpr9f8.jpg"
                      data-fancybox="works-slider"
                      class="mry-zoom mry-magnetic-link"
                      ><span class="mry-magnetic-object"
                        ><i class="fas fa-expand"></i></span
                      ></a
                    >
                    <a
                      href="/ourworkpages/CarabianCoast/"
                      class="mry-more mry-magnetic-link mry-anima-link"
                      ><span class="mry-magnetic-object"
                        ><i class="fas fa-arrow-right"></i></span
                      ></a
                    >
                  </div>
                </div>
                <div class="mry-item-descr mry-fo">
                  <h4 class="mry-mb-10">
                    <a href="/ourworkpages/CarabianCoast/">KP's House</a>
                  </h4>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <style>
      .mry-banner {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        overflow: hidden;
        padding: 0 !important;
      }

      .mry-banner .container {
        position: relative;
        z-index: 2;
      }

      .mry-head-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
      }

      .mry-head-bg img,
      .mry-head-bg .mry-bg-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .mry-head-bg img {
        opacity: 100%;
      }
    </style>
  </div></MainLayout
>
